<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Bogus" Version="35.6.5" />
      <PackageReference Include="Dapper" Version="2.1.89" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
      <!-- To "Fix": [NU1903] Package 'SQLitePCLRaw.lib.e_sqlite3' 2.1.11 has a known high severity vulnerability, https://github.com/advisories/GHSA-2m69-gcr7-jv3q-->
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    </ItemGroup>

</Project>
